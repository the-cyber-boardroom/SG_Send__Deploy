# SG/Send Deploy — local server configuration
# Copy this to .local-server.env and fill in values as needed.
# .local-server.env is gitignored.

# --- Provider mode ---
# Set to "true" to use real AWS EC2. Leave empty for in-memory twins.
# USE_AWS_PROVIDER=true

# --- AWS credentials (only needed when USE_AWS_PROVIDER=true) ---
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_DEFAULT_REGION=eu-west-1

# --- Status endpoint ---
# The EC2 instance ID to check in /deploy/status
# DEPLOY_INSTANCE_ID=i-0abc123def456

# --- Server ---
# DEPLOY_PORT=10062
# DEPLOY_HOST=0.0.0.0
# DEPLOY_USE_SSL=true

# --- Admin API key (optional, omit for dev-mode auto-auth) ---
# DEPLOY_ADMIN_API_KEY=your-secret-key

# --- Watchdog (only for Lambda, not used locally) ---
# WATCHDOG_IDLE_TIMEOUT_MINUTES=30
